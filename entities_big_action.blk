  //   tmplt:t="replicating+gamemodeFriendlyFire"
  // }
}

add_spawn_on_squadmates{
  _override:b=yes
  _use:t="game_effect_with_duration"
  game_effect__timeToDestroy:r=0.5
  game_effect__clientDestroyAt:r=-1.0
}

random_low_tickrate{
  _override:b=yes
  // disable low tickrate
  random_low_tickrate__currentDeadline:r=3.0
  random_low_tickrate__loweredTickrate:i=30
  random_low_tickrate__actionPeriod:r=1500.0
  random_low_tickrate__chanceToLower:r=100.0
  random_low_tickrate__chanceToReset:r=100.0
}

poly_battle_area{
  _override:b=yes
  battle_area__damage:r=1
  battle_area__damageInterval:r=1

  "battle_area__timeToDamageByType:object"{
    vehicle:r=20
    aircraft:r=30
    human:r=15
  }
}

big_action_capzone_signal_hud_icon{
  _use:t="big_action_base_hud_icon_effect"
  _use:t="client_game_effect_with_duration"
  _use:t="custom_marker"
  game_effect__timeToDestroy:r=150.0
  custom_marker__showForTeam:i=-1
  custom_marker__icon:t="!ui/skin#moveto.svg"
  custom_marker__iconColor:c=255, 255, 255, 160
  custom_marker__iconSize:p2=50, 50

  _group{
    _tags:t="ui"
    hud_icon__anyTeam:b=yes
    hud_icon__image:t="moveto"
    // map_icon__image:t="moveto"
    hud_icon__maxDistance:r=4000.0
    hud_icon__size:p2=6.6,6.6
    hud_icon__offsetY:r=0.6

    "map_icon__isActive:b"{
      value:b=yes
      _track:b=yes
    }
  }
}

