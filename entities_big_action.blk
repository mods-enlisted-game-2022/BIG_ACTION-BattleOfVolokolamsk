      attachTm:m=[[0.941937, -0.173657, -0.287911] [0.176155, 0.984288, -0.0173709] [0.286368, -0.0343505, 0.957609] [-0.13, -0.37, 0.095]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="commander"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="germ_pzkpfw_ii_ausf_h_gunner_cockpit"
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"
      hatchRotationAxis:p3=1.7, 0.0, 0.0
      maxPosWithOpenHatch:r=0.5
      isHoldGunModeAllowed:b=no

      "turretNames:array"{
        turret:t="turret_01"
      }

      "hatchNodes:array"{
        node:t="hatch_01"
      }

      // "effectors:object"{
      //   r.hand:t="righthand_1"
      //   l.hand:t="lefthand_1"
      //   r.foot:t="pedal_rfoot_1"
      //   l.foot:t="pedal_lfoot_1"
