grenade_thrower{
  _override:b=yes

  "gun__shells:array"{
    shells:t="content/enlisted/gamedata/weapons/grenades/m24.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/m24_smoke.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/m24_smoke_short_time.blk"
