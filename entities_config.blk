zombie_spawn_mode{
  _override:b=yes
  _use:t="game_effect_with_duration"
  _use:t="client_game_effect_with_duration"
  game_effect__timeToDestroy:r=2.0
  
  _group{
    _tags:t="server"
    game_effect__timeToDestroy:r=1.0
  }
}

