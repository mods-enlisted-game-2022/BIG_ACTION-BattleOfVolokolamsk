    }

    "bombDefused:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_deactivated_ally"
      enemy:t="vo/ui/enlisted/narrator/explosive_deactivated_enemy"
    }

    "taskPoint:object"{
      path:t="vo/ui/enlisted/narrator/task_point_defence"
      cooldown:r=2.0
    }

    "pointCapturingAlly:object"{
      path:t="vo/ui/enlisted/narrator/point_capturing_ally"
      cooldown:r=15.0
    }

    "pointCapturingEnemy:object"{
      path:t="vo/ui/enlisted/narrator/point_capturing_enemy"
