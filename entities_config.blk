    shells:t="content/enlisted/gamedata/weapons/grenades/usa_anm8_smoke.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/m24_flash.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/f1.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/rdg1_smoke.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/signal_flare.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/explosion_pack.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/ger_molotov.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/ussr_molotov.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/jap_molotov.blk"
