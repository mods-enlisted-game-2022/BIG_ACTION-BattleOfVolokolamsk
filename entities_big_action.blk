big_action_bomb_site_zone{
  // objective_zone_sphere+capzone_team_presence+defend_zone_team_chained_box+bomb_site_zone_chained_sphere
  _use:t="objective_zone_sphere"
  _use:t="capzone_team_presence"
  _use:t="defend_zone_team_chained_box"
  _use:t="bomb_site_zone_chained_sphere"
  
  _group{
    _tags:t="sound"

    "narrator__phrase:shared:object"{

      "allies:object"{

        "last_sector_left:object"{
          text:t="One last sector left!"
          phrase:t="oneSectorLeft"
        }

        "sector_captured:object"{
          text:t="We have explode the bomb!"
          phrase:t="sectorCapturedAlly"
        }

        "one_zone_to_capture:object"{
          text:t="Most of all bombs are explode, one left!"
          phrase:t="onePointToCapture"
        }

        "half_zones_captured:object"{
          text:t="We have explode more than half of all bombs!"
          phrase:t="halfPointsCaptured"
        }

        "zone_captured:object"{
          text:t="We have explode the bomb!"
          phrase:t="pointCaptured"
        }
      }

      "enemy:object"{

        "sector_captured:object"{
          text:t="Enemy have explode the bomb!"
          phrase:t="sectorCapturedEnemy"
        }

        "one_zone_to_capture:object"{
          text:t="Most of all bombs are explode by enemy, only one left to defend!"
          phrase:t="onePointToDefend"
        }

        "half_zones_captured:object"{
          text:t="Enemy have explode more than half of all bombs!"
          phrase:t="halfPointsCapturedEnemy"
        }

        "zone_captured:object"{
          text:t="Enemy have explode the bomb!"
          phrase:t="pointCapturedEnemy"
        }
      }
    }
  }
}

