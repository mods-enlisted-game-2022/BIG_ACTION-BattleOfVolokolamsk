    shells:t="content/enlisted/gamedata/weapons/grenades/srcm_mod_35_impact_grenade.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/m_15_incendiary_grenade.blk"
    shells:t="content/enlisted/gamedata/weapons/grenades/type_91_incendiary_grenade.blk"
