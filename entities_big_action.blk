big_action_bomb_site_charge_500kg{
  _extends:t="srcm_mod_35_impact_grenade_phys"
  _use:t="srcm_mod_35_impact_grenade_phys"
  phys_obj_net_phys__blk:t="content/enlisted/gamedata/weapons/grenades/no_69_impact_grenade.blk"

  _group{
    _tags:t="server"
    bullet_crater__explosiveMassOverride:r=300.0
  }

  "shell__concussionMaxRadius:r"{
    value:r=360.6
    _tags:t="server"
  }

  "shouldCreateShellCrater:tag"{
  }

  "on_explosion__create:list<t>"{
    tmplt:t="fire_source_no_fx+envir_fire_background_effect"
  }

  "animchar_no_update:tag"{
  }
}

big_action_explosion_midair_tiny_effect_bomb_site{
  _extends:t="explosion_midair_tiny_effect"
  _use:t="explosion_midair_tiny_effect"
  on_create__spawnShellTimer:r=0.69
  // on_create__spawnActivatedShellBlk:t="content/enlisted/gamedata/weapons/shells/mortar_shell.blk"
  on_create__spawnActivatedShellBlk:t="%ugm/data/weapons/shells/bomb_site_charge_500kg.blk"
}

bomb_site_charge{
  _override:b=yes
  _use:t="on_appear_sound"
  on_create__spawnShellTimer:r=0.1

  "on_explosion__create:list<t>"{
    tmplt:t="big_action_explosion_midair_tiny_effect_bomb_site+on_explosion"
    tmplt:t="tank_explosion_template"
    tmplt:t="fire_source_no_fx+envir_fire_background_small_effect+on_explosion"
    tmplt:t="fire_source_no_fx+envir_smoke_bg_thick_effect+on_explosion"
  }

  effect{
    _tags:t="render"
  }

  _group{
    _tags:t="render"
    effect__name:t="explosion_air_crash_land_cmps_fx"
  }

  _group{
    _tags:t="sound"
    on_appear_sound__path:t="impact/barrage_baloon"
  }
}

bomb_site_charge_water{
  _use:t="bomb_site_charge"
  _use:t="on_appear_sound"

  "on_explosion__create:list<t>"{
    tmplt:t="big_action_explosion_midair_tiny_effect_bomb_site+on_explosion"
    tmplt:t="tank_explosion_template"
    tmplt:t="fire_source_no_fx+envir_fire_background_small_effect+on_explosion"
    tmplt:t="fire_source_no_fx+envir_smoke_bg_thick_effect+on_explosion"
