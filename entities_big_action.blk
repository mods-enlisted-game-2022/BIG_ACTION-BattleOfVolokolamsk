  canUseRespawnbaseType:t="bigaction_vehicle"

  "canUseRespawnbaseSubtypes:list<t>"{
    subtype:t="default"
    subtype:t="builded_default"
    subtype:t="front_gr_default"
  }

  "animchar__objTexReplace:object"{
    "ger_camo_dunkelgelb*":t="ger_camo_grey*"
  }

  "turrets__initAmmoDistribution:array"{

    "ammo:object"{
      slot:i=1
      fill:b=yes
    }

    "ammo:object"{
      slot:i=2
      count:i=30
    }
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="commander"
