
big_action_explosion_280mm_effect{
  _use:t="explosion_effect"
  _use:t="hit_env_affect_fx"
  wind_emitter__radius:r=8.0
  wind_emitter__duration:r=5.5
  wind_emitter__strength:r=15.0
  wind_emitter__phaseSin:b=yes
  wind_emitter__numWaves:i=10
  wind_emitter__phaseAttack:b=yes

  "wind_emitter__omni:tag"{
  }

  _group{
    _tags:t="render"
    effect__name:t="explosion_air_crash_land_cmps_fx"
    effect__environmentDestructionRadius:r=50.0
  }

  "autodeleteEffectEntity:tag"{
  }
}

global_hit_fx_info{
  _override:b=yes

  _group{
    _hide:b=false

    "global_hit_fx__effectGroups:array"{

      "group:object"{
        name:t="nothing"
      }

      "group:object"{
        name:t="tank_grenades_smoke"
        defaultFx:t="explosion_tank_grenades_smoke_effect"
      }

      // add
      "group:object"{
        name:t="big_action_280mm"
        defaultFx:t="big_action_explosion_280mm_effect"
        waterSplashOnExplosion:b=yes

        "info:object"{

          "group__water:object"{
            fx:t="explosion_250_500kg_water_effect"
          }
        }
      }
      //---

      "group:object"{
