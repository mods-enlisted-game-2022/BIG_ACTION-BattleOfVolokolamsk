  capzone__smokeTemplateNeutral:t="capzone_signal_neutral_smoke_effect_big_action_D"
  capzone__smokeTemplateEnemy:t="capzone_signal_enemy_smoke_effect_big_action_D"
  active:b=no
  // capzone__deactivateAfterTimeout:r=1.0

  _group{
    _tags:t="sound"

    "narrator__phrase:shared:object"{

      "allies:object"{

        "zone_captured:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }

        "one_zone_to_capture:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }

        "half_zones_captured:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }

        "all_zones_captured:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }

        "sector_captured:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }
        
      }

      "enemy:object"{

        "zone_captured:object"{
          text:t="Enemy have captured zone!"
          phrase:t="sectorCapturedEnemy"
        }

        "one_zone_to_capture:object"{
          text:t="Enemy have captured zone!"
          phrase:t="sectorCapturedEnemy"
        }

        "half_zones_captured:object"{
          text:t="Enemy have captured zone!"
          phrase:t="sectorCapturedEnemy"
        }

        "sector_captured:object"{
          text:t="Enemy have captured zone!"
          phrase:t="sectorCapturedEnemy"
        }

      }
    }
  }
}

