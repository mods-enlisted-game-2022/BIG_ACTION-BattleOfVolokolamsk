big_action_capzone_ingame_patch{
  capzone__advantageDivisor:r=6.0
  capzone__maxCapDecapSpeedMult:r=3.0
  respawnBaseGroup:i=-1666
  respawnbaseType:t="nil"
  capzone__alwaysShow:b=no
  capzone__maxTeamPresence:i=12
  capzone__title:t="D"
  capzone__progress:r=0
  capzone__locked:b=no
  capzone__lockAfterActivate:b=no
  capzone__lockAfterCap:b=no
  capzone__unlockAfterTime:r=390
  capzone__decapTimeTeam2:r=230
  capzone__decapTimeTeam1:r=230
  capzone__capTimeTeam2:r=270
  capzone__capTimeTeam1:r=1230
  capzone__checkAllZonesInGroup:b=no
  capzone__icon:t="!ui/skin#victories_battles.svg"
  capzone__progress:r=0
  capzone__deactivateAfterCap:b=yes
  builder_info__team:i=1
  capzone__createRespawnBaseForTeam:i=1
  capzone__createdRespawnBaseGroup:i=-9666
  capzone__spawnAtZoneTimeout:r=190
  capzone__createRespawnBase:t="respawnBaseGroupActivator"
  capzone__capRewardTeam1:r=3000
  capzone__capRewardTeam2:r=3000
  capzone__capPenalty:r=6000
  team:i=2
  capzone__smokeDropHeight:r=5.0

  _group{
    _tags:t="sound"

    "narrator__phrase:shared:object"{

      "allies:object"{

        "zone_captured:object"{
          text:t="Our troops are back on defence, fighting the enemy"
          phrase:t="pointCaptured"
        }

        "sector_captured:object"{
          text:t="We have captured sector!"
          phrase:t="sectorCapturedAlly"
        }

      }

      "enemy:object"{

        "zone_captured:object"{
          text:t="Enemy troops are breaking through!"
          phrase:t="pointCapturedEnemy"
        }

        "sector_captured:object"{
          text:t="Enemy have captured zone!"
          phrase:t="sectorCapturedEnemy"
        }

      }
    }
  }
}

big_action_team_narrator_axis{
  _use:t="base_team_narrator"

  "team__narrator:object"{
    _tags:t="sound"

    "briefing:object"{
      path:t="vo/ui/enlisted/narrator/start_assault_attack"
      cooldown:r=2.0
    }

    "win:object"{
      path:t="vo/ui/enlisted/narrator/victory_invasion_attack"
      cooldown:r=2.0
    }

    "lose:object"{
      path:t="vo/ui/enlisted/narrator/defeat_invasion_attack"
      cooldown:r=2.0
    }

    "bombPlanting:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_installing_ally"
      enemy:t="vo/ui/enlisted/narrator/explosive_installing_enemy"
      cooldown:r=5.0
    }

    "bombPlanted:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_installed_ally"
      enemy:t="vo/ui/enlisted/narrator/explosive_installed_enemy"
    }

    "bombDefusing:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_deactivating_ally"
      enemy:t="vo/ui/enlisted/narrator/explosive_deactivating_enemy"
      cooldown:r=5.0
    }

    "bombDefused:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_deactivated_ally"
      enemy:t="vo/ui/enlisted/narrator/explosive_deactivated_enemy"
    }

    "pointDCapturingAlly:object"{
      path:t="vo/ui/enlisted/narrator/point_d_capturing_ally"
      cooldown:r=15.0
    }

    "pointDCaptured:object"{
      path:t="vo/ui/enlisted/narrator/point_d_captured_ally_invasion"
      cooldown:r=2.0
    }

    "pointDCapturingEnemy:object"{
      path:t="vo/ui/enlisted/narrator/point_d_capturing_enemy"
      cooldown:r=15.0
    }

    "pointDCapturedEnemy:object"{
      path:t="vo/ui/enlisted/narrator/point_d_captured_enemy_domination"
      cooldown:r=2.0
    }

    "pointCapturingAlly:object"{
      path:t="vo/ui/enlisted/narrator/point_capturing_ally"
      cooldown:r=15.0
    }

    "pointCapturingEnemy:object"{
      path:t="vo/ui/enlisted/narrator/point_capturing_enemy"
      cooldown:r=15.0
    }

    "pointCapturingPlayer:object"{
      path:t="vo/ui/enlisted/narrator/point_capturing_player"
      cooldown:r=15.0
    }

    "sectorCapturedEnemy:object"{
      path:t="vo/ui/enlisted/narrator/sector_captured_enemy_assault"
      cooldown:r=2.0
    }

    "halfPointsCapturedEnemy:object"{
      path:t="vo/ui/enlisted/narrator/half_points_invasion_defence"
      cooldown:r=2.0
    }

    "oneSectorLeft:object"{
      path:t="vo/ui/enlisted/narrator/last_sector_assault_defence"
      cooldown:r=2.0
    }

    "loosingScores:object"{
      ally:t=""
      enemy:t="vo/ui/enlisted/narrator/loosing_scores_enemy"
      cooldown:r=2.0
    }

    "leftBattleArea:object"{
      path:t="vo/ui/enlisted/narrator/leave_area_warn"
      cooldown:r=2.0
    }

    "bombPlanting:object"{
      ally:t="vo/ui/enlisted/narrator/explosive_installing_ally"
