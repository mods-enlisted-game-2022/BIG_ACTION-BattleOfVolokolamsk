big_action_bunker_repair_box{
  _extends:t="medik_box_base"
  _extends:t="ammunition_box_a"
  _extends:t="human_hidden_ui_battle_area"
  _extends:t="base_fortification_build"
  _extends:t="undestroyable_building"
  _use:t="medik_box_base"
  _use:t="ammunition_box_a"
  _use:t="human_hidden_ui_battle_area"
  _use:t="base_fortification_build"
  _use:t="undestroyable_building"
  team:i=1
  animchar__res:t="repair_tools_char"
  collres__res:t="repair_tools_collision"
  useful_box__itemExistTag:t="item__repair_kit"
  useful_box__giveItem:t="repair_kit_item"
  useful_box__maxUseCount:i=99999
  minimap__visibleRadius:r=1
  minimap__visibleForAll:b=no
  building_menu__image:t=""
  hud_icon__image:t="perks/repair_speed_icon"
}

big_action_train_kv_2{
  _use:t="train_panzerjagerwagen"
  _use:t="base_wagen"

  "animchar__objTexReplace:object"{
    "kommando_infanterie_wagen_tex_d*":t="ussr_camo_green*"
    "ger_camo_dunkelgelb_green_braun_big_blots*":t="ussr_camo_green*"
  }

  "is_occluder:tag"{
  }
}

big_action_kv_2_bunker_turret_gunner_cockpit{
  _use:t="base_gunner_cockpit"
  animchar__res:t="ba_11_gunner_char"
  cockpit__offset:p3=0.0, -0.30, 0.115 //first one X, second is Z third Y

  "cockpit__attachNodeNames:list<t>"{
    node:t="bone_camera_gunner"
  }

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    slit:p3=-0.5, -0.07, 0.2
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
    node:t="@root"
    node:t="bone_gun"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front_right"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.22
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
  }

  "cockpit__periscopeLimits:list<p4>"{
    slit:p4=-0.0, 0.0, 0.0, 0.0
  }

  "cockpit__periscopeSpeed:list<p2>"{
    slit:p2=-1.0, -1.0
